# Runtime environment: development, test, or production
ENVIRONMENT=development

# PostgreSQL connection (replace with your own connection string)
DATABASE_URL=postgresql://expense_tracker:expense_tracker@localhost:5432/expense_tracker

# Security & JWT Configuration
SECRET_KEY=generate-a-long-random-value-before-running-the-api
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=expense-tracker-api
JWT_AUDIENCE=expense-tracker-client

# Application Configuration
APP_NAME=Expense Tracker API
API_V1_PREFIX=/api/v1
DEBUG=False
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Daily and historical reference rates (Frankfurter v2 by default)
EXCHANGE_RATE_API_URL=https://api.frankfurter.dev/v2
EXCHANGE_RATE_TIMEOUT_SECONDS=10

# Statement import limits
IMPORT_MAX_FILE_SIZE_BYTES=5242880
IMPORT_MAX_ROWS=5000
